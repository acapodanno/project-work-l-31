# Chiave API OpenAI. Se lasciata vuota, l'agente funziona comunque in modalità
# offline/mock (RAG deterministico + router a parole chiave), senza costi e senza
# bisogno di connessione a servizi esterni: utile per demo, test e CI.
OPENAI_API_KEY=

# URL del backend Spring Boot su cui l'agente apre i ticket di assistenza.
BACKEND_URL=http://localhost:8080/api

# Cartella contenente la knowledge base (FAQ) usata dal motore RAG.
DATA_DIR=./data
